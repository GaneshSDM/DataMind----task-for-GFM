# Dockerfile.agents — single image shared by all six agents.
# The whole repo is copied in so the agents' hardcoded relative paths
# (../../backend/.env, ../IntentClassifier/schema_reference.json) resolve.
# docker-compose.yml gives each agent its own working_dir + command.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/models \
    TRANSFORMERS_CACHE=/models

# System libs: psycopg2 runtime + curl for healthchecks
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq5 curl \
    && rm -rf /var/lib/apt/lists/*

# Install CPU-only torch first (keeps the image far smaller than the default CUDA build),
# then the rest of the agent deps.
COPY docker/requirements.agents.txt /tmp/requirements.agents.txt
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir -r /tmp/requirements.agents.txt

WORKDIR /app
COPY . /app

# Default; overridden per service in docker-compose.yml
EXPOSE 8001 8002 8003 8004 8005 8006
CMD ["python", "--version"]
