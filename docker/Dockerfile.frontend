# Dockerfile.frontend — build the React app, serve it with nginx,
# and reverse-proxy /api -> backend:8000 (same origin, so no VITE_BACKEND_URL needed).

# ---- Stage 1: build the Vite app ----
FROM node:20-alpine AS build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build          # outputs /app/dist

# ---- Stage 2: nginx serving the static build ----
FROM nginx:alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
