{
  "domains": {
    "finance": {
      "description": "Financial data — budgets, transactions, payroll",
      "subdomains": {
        "budget": {
          "table": "finance_budgets",
          "columns": [
            "id", "department_id", "budget_allocated", "budget_spent",
            "fiscal_year", "approved_by", "created_at", "updated_at"
          ],
          "sensitive_columns": ["approved_by"]
        },
        "payroll": {
          "table": "finance_payroll",
          "columns": [
            "id", "employee_id", "salary", "bonus", "bank_account",
            "ssn", "pay_period_start", "pay_period_end", "created_at"
          ],
          "sensitive_columns": ["salary", "bonus", "bank_account", "ssn"]
        },
        "transactions": {
          "table": "finance_transactions",
          "columns": [
            "id", "transaction_type", "amount", "currency", "department_id",
            "vendor_id", "description", "transaction_date", "created_at"
          ],
          "sensitive_columns": ["vendor_id"]
        }
      }
    },
    "hr": {
      "description": "Human resources — employees, departments, performance",
      "subdomains": {
        "employees": {
          "table": "hr_employees",
          "columns": [
            "id", "employee_name", "email", "phone", "title",
            "department_id", "manager_id", "hire_date", "termination_date",
            "salary", "ssn", "birth_date", "created_at", "updated_at"
          ],
          "sensitive_columns": ["salary", "ssn", "phone", "email"]
        },
        "performance": {
          "table": "hr_performance",
          "columns": [
            "id", "employee_id", "review_period", "performance_rating",
            "reviewer_id", "goals_achieved", "notes", "created_at"
          ],
          "sensitive_columns": ["performance_rating", "notes"]
        },
        "benefits": {
          "table": "hr_benefits",
          "columns": [
            "id", "employee_id", "benefit_type", "coverage_level",
            "premium", "enrolled_date", "effective_date", "created_at"
          ],
          "sensitive_columns": ["premium"]
        }
      }
    },
    "sales": {
      "description": "Sales pipeline — leads, deals, accounts",
      "subdomains": {
        "leads": {
          "table": "sales_leads",
          "columns": [
            "id", "lead_name", "company", "industry", "source",
            "assigned_to", "status", "created_at", "updated_at"
          ],
          "sensitive_columns": []
        },
        "deals": {
          "table": "sales_deals",
          "columns": [
            "id", "lead_id", "deal_stage", "deal_value", "margin",
            "commission_pct", "competitor_notes", "assigned_to",
            "expected_close_date", "created_at", "updated_at"
          ],
          "sensitive_columns": ["margin", "commission_pct", "competitor_notes"]
        },
        "accounts": {
          "table": "sales_accounts",
          "columns": [
            "id", "company_name", "account_owner", "annual_revenue",
            "contract_start", "contract_end", "tier", "created_at"
          ],
          "sensitive_columns": ["annual_revenue"]
        }
      }
    },
    "inventory": {
      "description": "Inventory and supply chain",
      "subdomains": {
        "products": {
          "table": "inventory_products",
          "columns": [
            "id", "product_name", "sku", "category", "unit_price",
            "cost_price", "stock_level", "supplier_id", "reorder_point",
            "created_at", "updated_at"
          ],
          "sensitive_columns": ["cost_price", "supplier_id"]
        },
        "warehouse": {
          "table": "inventory_warehouse",
          "columns": [
            "id", "warehouse_name", "location", "capacity",
            "product_id", "quantity", "last_restock_date", "created_at"
          ],
          "sensitive_columns": []
        }
      }
    },
    "support": {
      "description": "Customer support and ticketing",
      "subdomains": {
        "tickets": {
          "table": "support_tickets",
          "columns": [
            "id", "ticket_subject", "customer_name", "customer_email",
            "customer_phone", "status", "priority", "assigned_to",
            "first_response_at", "resolved_at", "sla_breach_log",
            "internal_notes", "created_at", "updated_at"
          ],
          "sensitive_columns": ["customer_email", "customer_phone", "sla_breach_log", "internal_notes"]
        }
      }
    },
    "engineering": {
      "description": "Engineering — projects, bugs, deployments",
      "subdomains": {
        "projects": {
          "table": "eng_projects",
          "columns": [
            "id", "project_name", "tech_lead_id", "status",
            "start_date", "end_date", "created_at", "updated_at"
          ],
          "sensitive_columns": []
        },
        "bugs": {
          "table": "eng_bugs",
          "columns": [
            "id", "bug_title", "severity", "assigned_to",
            "reported_by", "project_id", "status",
            "found_in_version", "fixed_in_version",
            "created_at", "updated_at"
          ],
          "sensitive_columns": ["reported_by"]
        }
      }
    }
  }
}
